# ---------------------------------------------------------------------------
# Velo Checkout — variáveis de ambiente (copie para .env.local e preencha).
# Nunca coloque segredos em variáveis NEXT_PUBLIC_*: elas vão para o navegador.
# ---------------------------------------------------------------------------

# Obrigatória. Seleciona o modo (não é segredo):
#   api  → painel com login e banco; checkout demo continua disponível como demonstração
#   demo → somente o checkout de demonstração, sem servidor e sem painel
NEXT_PUBLIC_DATA_SOURCE=api

# Somente servidor. String de conexão do Postgres do Supabase usada pela aplicação.
# No Supabase: Project → Connect → Transaction pooler (porta 6543).
DATABASE_URL=

# Opcional, somente servidor. Conexão usada por `npm run db:migrate`
# (Session pooler, porta 5432, ou conexão direta). Sem ela, usa DATABASE_URL.
MIGRATION_DATABASE_URL=

# Somente servidor. Chave AES-256 (32 bytes em base64) que cifra tokens da Shopify
# e chaves da Whop no banco. Obrigatória a partir da etapa de integrações.
# Gere com: openssl rand -base64 32
VELO_ENCRYPTION_KEY=
